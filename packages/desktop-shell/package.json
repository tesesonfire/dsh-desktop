{
  "name": "dsh-desktop-shell",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "DSH Cordis plugin exposing ctx.desktopRuntime — the in-host half of the dsh-desktop shell contract.",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dsh-desktop/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/node": "^24.5.0"
  }
}
