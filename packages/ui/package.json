{
  "name": "@dsh-desktop/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Shared React components for both desktop frontends (Tauri + Electron render the same UI).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
